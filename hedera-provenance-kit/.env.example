# ==========================================
# HEDERA PROVENANCE KIT: CONFIGURATION
# ==========================================

# Hedera Network ('testnet' | 'mainnet' | 'previewnet')
HEDERA_NETWORK=testnet

# Execution Mode ('real' | 'mock')
# In 'real' mode, valid operator credentials submit real HCS transactions.
# In 'mock' mode, offline cryptographic sandbox calculates real SHA-256 without spending HBAR.
HEDERA_MODE=real

# Operator Account ID (format: 0.0.xxxxxx)
HEDERA_ACCOUNT_ID=0.0.1234567

# Operator Private Key (DER or HEX encoded ED25519/ECDSA private key)
# NEVER commit or expose this key!
HEDERA_PRIVATE_KEY=your_private_key_here

# Hedera Consensus Service Topic ID (format: 0.0.xxxxxx)
# To create an open topic automatically, leave empty or set to your topic ID.
HEDERA_TOPIC_ID=0.0.10818730

# Hedera Mirror Node REST Endpoint
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Frontend Public API URL (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000
