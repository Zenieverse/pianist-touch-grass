  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.impl.ts --bundle --platform=node --format=cjs --external:vite --external:lightningcss --sourcemap --outfile=dist/server.cjs && node scripts/prepare-build-artifacts.cjs",
