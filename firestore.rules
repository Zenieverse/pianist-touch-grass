rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check user ownership
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if true; // Allow client applet user access
    }

    // Health and clinical records
    match /healthRecords/{recordId} {
      allow read, write: if true;
    }

    // Consultations and chat sessions
    match /consultations/{consultationId} {
      allow read, write: if true;
    }

    // Skin analyses
    match /skinAnalyses/{analysisId} {
      allow read, write: if true;
    }

    // Cloud audit and infrastructure telemetry logs
    match /cloudAuditLogs/{logId} {
      allow read, write: if true;
    }
  }
}
