{
  "harnessVersion": "1.0.0",
  "platform": "Dr. T Healthcare Ecosystem & Hedera Commons",
  "license": "MIT",
  "bountyTrack": "Hedera Developer Agent & Verifiable AI Trust Infrastructure",
  "metadata": {
    "name": "Dr. T Hedera Harness",
    "description": "Declarative Hedera service specifications, canonical integration patterns, and 5-tier automated validation harness for verifiable AI trust, research provenance, and zero-PHI health integrity.",
    "repository": "https://github.com/Zenieverse/Dr.-T",
    "author": "Dr. T Engineering & Zenieverse",
    "environment": {
      "runtime": "Node.js >= 20.0.0",
      "framework": "React 18 / Express 5 / TypeScript 5.7",
      "sdk": "@hashgraph/sdk v2.76.0"
    }
  },
  "networkTargets": {
    "testnet": {
      "mirrorNode": "https://testnet.mirrornode.hedera.com",
      "explorer": "https://hashscan.io/testnet",
      "defaultTopicId": "0.0.5892147"
    },
    "mainnet": {
      "mirrorNode": "https://mainnet.mirrornode.hedera.com",
      "explorer": "https://hashscan.io/mainnet"
    },
    "mockSandbox": {
      "mode": "mock",
      "ledger": "deterministic-in-memory",
      "explorerLinksEnabled": false
    }
  },
  "services": {
    "hcs": {
      "serviceCode": "HCS",
      "topicIdEnv": "HEDERA_TOPIC_ID",
      "defaultTopic": "0.0.5892147",
      "schema": "drt.provenance.v1",
      "transactionType": "TopicMessageSubmitTransaction"
    },
    "mirrorNode": {
      "serviceCode": "MIRROR",
      "baseUrlEnv": "HEDERA_MIRROR_NODE_URL",
      "defaultBaseUrl": "https://testnet.mirrornode.hedera.com",
      "endpoints": {
        "topicMessageBySeq": "/api/v1/topics/{topicId}/messages/{sequenceNumber}",
        "recentMessages": "/api/v1/topics/{topicId}/messages?limit={limit}&order=desc",
        "accountBalance": "/api/v1/accounts/{accountId}"
      }
    },
    "privacyGuard": {
      "standard": "Zero-PHI-HIPAA-GDPR",
      "enforceRule": "Only SHA-256 cryptographic digests transmitted on-chain"
    },
    "cryptographicEngine": {
      "algorithm": "SHA-256",
      "canonicalization": "RFC 8785 JSON"
    }
  },
  "validationTiers": [
    {
      "tier": 1,
      "id": "tier1_schema_crypto",
      "name": "Static Schema & Cryptographic Integrity",
      "validatorPath": "hedera_harness/validators/tier1_schema_crypto.ts"
    },
    {
      "tier": 2,
      "id": "tier2_privacy_security",
      "name": "Privacy, HIPAA/GDPR & Zero-PHI Compliance",
      "validatorPath": "hedera_harness/validators/tier2_privacy_security.ts"
    },
    {
      "tier": 3,
      "id": "tier3_hcs_transaction",
      "name": "Hedera Consensus Service Operations",
      "validatorPath": "hedera_harness/validators/tier3_hcs_transaction.ts"
    },
    {
      "tier": 4,
      "id": "tier4_mirror_node",
      "name": "Mirror Node REST Audit & Hashscan Explorer",
      "validatorPath": "hedera_harness/validators/tier4_mirror_node.ts"
    },
    {
      "tier": 5,
      "id": "tier5_e2e_tamper",
      "name": "End-to-End Orchestration & Tamper Resilience",
      "validatorPath": "hedera_harness/validators/tier5_e2e_tamper.ts"
    }
  ]
}
